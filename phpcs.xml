<?xml version="1.0"?>
<ruleset name="kirby-base">
    <description>Coding standards for the kirby-base plugin.</description>

    <rule ref="PSR12"/>

    <rule ref="SlevomatCodingStandard.TypeHints.ParameterTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.ReturnTypeHint"/>
    <rule ref="SlevomatCodingStandard.TypeHints.PropertyTypeHint"/>

    <rule ref="SlevomatCodingStandard.Namespaces.UnusedUses"/>
    <rule ref="SlevomatCodingStandard.TypeHints.DeclareStrictTypes"/>

    <file>classes</file>
    <file>sections</file>
    <file>snippets</file>
    <file>templates</file>

    <exclude-pattern>*/kirby/*</exclude-pattern>
    <exclude-pattern>*/content/*</exclude-pattern>
    <exclude-pattern>*/media/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <arg name="colors"/>
    <arg name="cache"/>
    <arg value="p"/>
    <arg name="severity" value="5"/>
    <arg name="warning-severity" value="5"/>

</ruleset>